# Секреты для qlik-analyzer. Скопируйте в .env и заполните.
# .env НЕ должен попадать в git (уже в .gitignore).

# Пароль доменного пользователя Qlik Sense Enterprise on Windows
QLIK_QS_PASSWORD=

# Пароль для QlikView Server
QLIK_QV_PASSWORD=

# API-ключ Qlik Cloud (если используете облако)
QLIK_API_KEY=

# Альтернативные имена переменных
# QLIK_PASSWORD=
# QLIK_ANALYZER_ENV=qs-prod
# QLIK_ANALYZER_APP=sales
# QLIK_ANALYZER_CONFIG=/path/to/qlik-analyzer.config.json
