# Секреты для qlik-analyzer. Скопируйте в .env и заполните.
# .env НЕ должен попадать в git (уже в .gitignore).

# Пароль доменного пользователя Qlik Sense Enterprise on Windows
QLIK_QS_PASSWORD=

# Пароль для QlikView Server
QLIK_QV_PASSWORD=

# API-ключ Qlik Cloud (если используете облако)
QLIK_API_KEY=

# Альтернативные имена переменных
# QLIK_PASSWORD=
# QLIK_ANALYZER_ENV=qs-prod
# QLIK_ANALYZER_APP=sales
# Альтернативные имена переменных
# QLIK_PASSWORD=
# QLIK_ANALYZER_ENV=qs-prod
# QLIK_ANALYZER_APP=sales
# QLIK_ANALYZER_CONFIG=/path/to/qlik-analyzer.config.json

# --- Репозиторий QRS (Qlik Sense Enterprise, порт 4242) ---
# Видит и неопубликованные приложения; доступ — по клиентскому сертификату.
# QLIK_QRS_ENABLED=1
# QLIK_QRS_HOST=qlik-sense.corp.local
# QLIK_QRS_PORT=4242
# QLIK_QRS_CERT=/путь/к/client.pfx
# QLIK_QRS_KEY=/путь/к/client.key
# Пароль сертификата (если .pfx):
# QLIK_QRS_CERT_PASSWORD=

# --- ИИ-слой ---------------------------------------------------------------
# Ключи провайдеров. В репозитории ключей нет; в приложении ключ хранится
# в зашифрованном виде (safeStorage) и не передаётся в интерфейс.

# Z.ai — бесплатная модель glm-4.7-flash. Нужен Standard API Key.
QLIK_AI_ZAI_KEY=

# Google Gemini — бесплатный тариф Flash. Ключ из AI Studio.
QLIK_AI_GEMINI_KEY=

# Локальная модель (Ollama или LM Studio) — ключ не нужен:
# QLIK_AI_LOCAL_BASE_URL=http://localhost:11434/v1

# Выбор провайдера и цепочки: zai | gemini | local
# QLIK_AI_PROVIDER=zai
# QLIK_AI_FALLBACK=gemini,local
# QLIK_AI_MODEL=glm-4.7-flash

# Режим конфиденциальности: 1 — данные не покидают машину (только локальная модель)
# QLIK_AI_SENSITIVE=1

# Лимиты запросов (для бесплатных тарифов)
# QLIK_AI_RPM=10
# QLIK_AI_DAILY_CAP=200
# QLIK_AI_CACHE_TTL_MS=60000
# QLIK_AI_MAX_SUMMARY=12000
# QLIK_ANALYZER_CONFIG=/path/to/qlik-analyzer.config.json
