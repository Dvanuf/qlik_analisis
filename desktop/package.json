{
  "name": "qlik-analyzer-desktop",
  "version": "0.1.6",
  "private": true,
  "description": "Десктоп-приложение qlik-analyzer: анализ качества приложений Qlik Sense / QlikView",
  "main": "dist/main/main.js",
  "scripts": {
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "start": "electron .",
    "dev": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "package:mac": "npm run build && electron-builder --mac --dir",
    "package:win": "npm run build && electron-builder --win --x64 --dir",
    "smoke": "npm run build && QA_SMOKE=1 electron ."
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
